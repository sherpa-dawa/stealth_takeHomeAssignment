# Allow legacy peer dependencies
# Needed because @testing-library/react@15.0.0-next.1 expects React 18
# but we're using React 19 (stable release)
legacy-peer-deps=true

# Performance settings
fetch-timeout=60000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Security settings
audit=false
fund=false
